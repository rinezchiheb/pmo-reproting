# Copier ce fichier en ".env" puis compléter. Ne jamais commiter .env.

# Jeton d'accès personnel Jira (Profil Jira > Jetons d'accès personnels)
JIRA_TOKEN=

# Optionnel : surcharges des paramètres enregistrés dans MongoDB
# JIRA_BASE_URL=https://ticketing.be-ys.com
# JIRA_VERIFY_SSL=true
# DATA_SOURCE=jira        # ou "excel" pour le mode démo

# --- Paramètres dans l'application (page « Paramètres ») ---
# Adresse de la base MongoDB (obligatoire) : tous les paramètres de l'outil y sont enregistrés.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=pmo_reporting
# Code demandé pour enregistrer une modification. Vide : modifications refusées.
# ADMIN_CODE=
